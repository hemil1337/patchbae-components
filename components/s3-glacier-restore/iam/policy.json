{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RestoreAndCheckObjects",
      "Effect": "Allow",
      "Action": ["s3:RestoreObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::<MEDIA_BUCKET>/<MEDIA_PREFIX>*"
    },
    {
      "Sid": "TellMissingFromForbidden",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::<MEDIA_BUCKET>"
    }
  ]
}
