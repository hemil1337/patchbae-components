{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SubmitTranscodeJobs",
      "Effect": "Allow",
      "Action": ["mediaconvert:CreateJob"],
      "Resource": [
        "arn:aws:mediaconvert:<REGION>:<ACCOUNT_ID>:queues/*",
        "arn:aws:mediaconvert:<REGION>:<ACCOUNT_ID>:presets/*",
        "arn:aws:mediaconvert:<REGION>:<ACCOUNT_ID>:jobTemplates/*"
      ]
    },
    {
      "Sid": "FollowJobs",
      "Effect": "Allow",
      "Action": ["mediaconvert:GetJob"],
      "Resource": "arn:aws:mediaconvert:<REGION>:<ACCOUNT_ID>:jobs/*"
    },
    {
      "Sid": "FindTheJobOfAnEarlierDelivery",
      "Effect": "Allow",
      "Action": ["mediaconvert:SearchJobs"],
      "Resource": "arn:aws:mediaconvert:<REGION>:<ACCOUNT_ID>:queues/*"
    },
    {
      "Sid": "ReadJobTemplates",
      "Effect": "Allow",
      "Action": ["mediaconvert:GetJobTemplate"],
      "Resource": "arn:aws:mediaconvert:<REGION>:<ACCOUNT_ID>:jobTemplates/*"
    },
    {
      "Sid": "PassTheServiceRoleToMediaConvert",
      "Effect": "Allow",
      "Action": ["iam:PassRole"],
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/<MEDIACONVERT_ROLE_NAME>",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "mediaconvert.amazonaws.com"
        }
      }
    }
  ]
}
