{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "HarvestFromTheChannelGroup",
      "Effect": "Allow",
      "Action": ["mediapackagev2:CreateHarvestJob", "mediapackagev2:GetHarvestJob"],
      "Resource": [
        "arn:aws:mediapackagev2:<REGION>:<ACCOUNT_ID>:channelGroup/<CHANNEL_GROUP>/channel/*/originEndpoint/*",
        "arn:aws:mediapackagev2:<REGION>:<ACCOUNT_ID>:channelGroup/<CHANNEL_GROUP>/channel/*/originEndpoint/*/harvestJob/*"
      ]
    },
    {
      "Sid": "PublishVodAssets",
      "Effect": "Allow",
      "Action": ["mediapackage-vod:CreateAsset", "mediapackage-vod:DescribeAsset", "mediapackage-vod:TagResource"],
      "Resource": [
        "arn:aws:mediapackage-vod:<REGION>:<ACCOUNT_ID>:assets/*",
        "arn:aws:mediapackage-vod:<REGION>:<ACCOUNT_ID>:packaging-groups/<PACKAGING_GROUP_ID>"
      ]
    },
    {
      "Sid": "PassTheSourceRoleToMediaPackage",
      "Effect": "Allow",
      "Action": ["iam:PassRole"],
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/<MEDIAPACKAGE_ROLE_NAME>",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "mediapackage.amazonaws.com"
        }
      }
    }
  ]
}
